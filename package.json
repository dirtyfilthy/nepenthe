{
  "name": "nepenthe",
  "version": "0.1.6",
  "private": true,
  "license": "MIT",
  "description": "Disappearing browsing history for Firefox",
  "scripts": {
    "start": "npx web-ext@10.8.0 run",
    "test": "node --test test/*.test.cjs",
    "e2e": "node test/e2e.mjs",
    "build-psl": "node tools/build-psl.mjs",
    "package": "rm -f nepenthe.zip && zip -r -q nepenthe.zip manifest.json src options icons && echo nepenthe.zip",
    "sign": "node tools/sign.mjs",
    "install-signed": "node tools/install-signed.mjs",
    "lint": "npx web-ext@10.8.0 lint",
    "release": "node tools/release.mjs",
    "amo-status": "node tools/amo-status.mjs",
    "listing": "node tools/listing.mjs",
    "wiki": "node tools/wiki.mjs"
  }
}
